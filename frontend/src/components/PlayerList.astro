---
interface Props {
	players?: readonly string[];
}

const { players = [] } = Astro.props;
---

<div class="player-list">
	{
		players.length > 0 ? (
			<ul>
				{players.map((player) => (
					<li>
						<span aria-hidden="true">{player.charAt(0).toUpperCase()}</span>
						{player}
					</li>
				))}
			</ul>
		) : (
			<p>No players online</p>
		)
	}
</div>

<style>
	.player-list ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.player-list li {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		color: var(--text-secondary);
		font-size: 0.875rem;
	}

	.player-list li span {
		display: grid;
		width: 1.8rem;
		height: 1.8rem;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface-raised);
		color: var(--text-primary);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.player-list p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.875rem;
	}
</style>
