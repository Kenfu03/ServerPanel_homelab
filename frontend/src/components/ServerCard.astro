---
import MetricCard from "./MetricCard.astro";
import type { GameServer } from "../types/server";

interface Props {
	server: GameServer;
}

const { server } = Astro.props;
const { name, game, version, online, players, metrics } = server;

const gameLabel = version ? `${game} ${version}` : game;
const playerCount = online ? `${players.online} / ${players.max}` : "--";

const formatUptime = (totalSeconds: number): string => {
	const totalMinutes = Math.floor(totalSeconds / 60);
	const hours = Math.floor(totalMinutes / 60);
	const minutes = totalMinutes % 60;

	return hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;
};

const formatMemory = (memoryMb: number): string => {
	return memoryMb >= 1024 ? `${(memoryMb / 1024).toFixed(1)} GB` : `${memoryMb} MB`;
};

const uptime = online ? formatUptime(metrics.uptimeSeconds) : "--";
const memory = online ? formatMemory(metrics.memoryMb) : "--";
const cpu = online ? `${metrics.cpuPercent}%` : "--";
---

<article class:list={["server-card", { offline: !online }]}>
	<header class="server-header">
		<div>
			<p class="game-label">{gameLabel}</p>
			<h2>{name}</h2>
		</div>
		<div class:list={["server-status", online ? "online" : "offline"]}>
			<span aria-hidden="true"></span>
			{online ? "Online" : "Offline"}
		</div>
	</header>

	<div class="player-summary">
		<div class="player-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none">
				<path d="M16 20v-1.5A3.5 3.5 0 0 0 12.5 15h-5A3.5 3.5 0 0 0 4 18.5V20M10 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM17 11.5a3 3 0 0 1 3 3V16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
			</svg>
		</div>
		<div>
			<span>Players</span>
			<strong>{playerCount}</strong>
		</div>
	</div>

	<div class="metrics">
		<MetricCard label="Uptime" value={uptime} />
		<MetricCard label="RAM" value={memory} />
		<MetricCard label="CPU" value={cpu} />
	</div>

	<footer>
		<a class="manage-button" href="#" aria-label={`Manage ${name} server`}>
			Manage Server
			<svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path d="m7.5 5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</a>
	</footer>
</article>

<style>
	.server-card {
		display: flex;
		min-height: 25rem;
		flex-direction: column;
		border: 1px solid var(--border-strong);
		border-radius: 1rem;
		background: var(--surface-card);
		padding: 1.5rem;
		box-shadow: 0 18px 45px rgb(0 0 0 / 16%);
		transition: border-color 180ms ease, transform 180ms ease;
	}

	.server-card:hover {
		transform: translateY(-2px);
		border-color: #3b3f47;
	}

	.server-card.offline {
		background: var(--surface-card-muted);
	}

	.server-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.game-label {
		margin: 0 0 0.45rem;
		color: var(--text-muted);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-size: 1.45rem;
		font-weight: 650;
		letter-spacing: -0.03em;
	}

	.server-status {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		border: 1px solid;
		border-radius: 999px;
		padding: 0.4rem 0.65rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.03em;
	}

	.server-status span {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: currentColor;
	}

	.server-status.online {
		border-color: rgb(52 211 153 / 22%);
		background: rgb(52 211 153 / 8%);
		color: var(--online);
	}

	.server-status.offline {
		border-color: rgb(248 113 113 / 20%);
		background: rgb(248 113 113 / 7%);
		color: var(--offline);
	}

	.player-summary {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-top: 2.5rem;
	}

	.player-icon {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--border);
		border-radius: 0.7rem;
		background: var(--surface-raised);
		color: var(--text-secondary);
	}

	.player-icon svg {
		width: 1.3rem;
		height: 1.3rem;
	}

	.player-summary div:last-child {
		display: grid;
		gap: 0.15rem;
	}

	.player-summary span {
		color: var(--text-muted);
		font-size: 0.72rem;
	}

	.player-summary strong {
		font-size: 1rem;
		font-weight: 620;
	}

	.metrics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
		margin-top: 1.5rem;
	}

	footer {
		margin-top: auto;
		padding-top: 2rem;
	}

	.manage-button {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		border: 1px solid var(--border-strong);
		border-radius: 0.7rem;
		background: var(--surface-raised);
		padding: 0.8rem 1rem;
		color: var(--text-primary);
		font-size: 0.82rem;
		font-weight: 650;
		text-decoration: none;
		transition: 160ms ease;
	}

	.manage-button svg {
		width: 1rem;
		height: 1rem;
		transition: transform 160ms ease;
	}

	.manage-button:hover {
		border-color: #4b5059;
		background: var(--surface-hover);
	}

	.manage-button:hover svg {
		transform: translateX(2px);
	}

	@media (max-width: 420px) {
		.server-card {
			min-height: 23rem;
			padding: 1.25rem;
		}

		.metrics {
			gap: 0.45rem;
		}
	}
</style>
