---
interface Props {
	label: string;
	value: string;
	dataKey?: string;
}

const { label, value, dataKey } = Astro.props;
---

<div class="metric" data-metric={dataKey}>
	<span>{label}</span>
	<strong>{value}</strong>
</div>

<style>
	.metric {
		display: grid;
		gap: 0.45rem;
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: 0.7rem;
		background: rgb(255 255 255 / 1.5%);
		padding: 0.8rem;
	}

	.metric span {
		color: var(--text-muted);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.metric strong {
		overflow: hidden;
		color: var(--text-primary);
		font-size: 0.95rem;
		font-weight: 620;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>
